import sys, numpy as np
from PIL import Image
S=sys.argv[1]
src=np.array(Image.open('artwork/actua-hero.png').convert('RGB')).astype(float)
H,W,_=src.shape
yy,xx=np.mgrid[0:H,0:W]
clean=np.zeros((H,W),bool); clean[:, :960]=True
for (x0,y0,x1,y1) in [(100,140,470,225),(100,240,900,665),(100,685,890,800)]:
    clean[y0-10:y1+10, x0-10:x1+10]=False
idx=np.where(clean)
sel=np.random.default_rng(0).choice(len(idx[0]),20000,replace=False)
def feats(x,y): return np.stack([np.ones_like(x),x,y,x*x,y*y,x*y,x**3,y**3,x*x*y,x*y*y],-1)
A=feats(idx[1][sel]/W, idx[0][sel]/H)
coef=[np.linalg.lstsq(A,src[idx[0][sel],idx[1][sel],c],rcond=None)[0] for c in range(3)]
F=feats(xx/W,yy/H)
model=np.stack([F@coef[c] for c in range(3)],-1)
t=np.clip((xx-890)/70,0,1)[...,None]   # feather 890..960 into the original
out=model*(1-t)+src*t
y0,y1,x0,x1=240,665,100,900
a=np.clip((np.abs(src[y0:y1,x0:x1]-model[y0:y1,x0:x1]).sum(-1)-8)/40,0,1)[...,None]
bh=y1-y0; ny=(H-bh)//2
out[ny:ny+bh,x0:x1]=out[ny:ny+bh,x0:x1]*(1-a)+src[y0:y1,x0:x1]*a
img=Image.fromarray(np.clip(out,0,255).round().astype('uint8'))
ch=round(W*500/1024); top=(H-ch)//2
img.crop((0,top,W,top+ch)).resize((1024,500),Image.LANCZOS).save(f'{S}/featureGraphic.png')
img.save(f'{S}/hero-clean.png')
print([img.getpixel((x,500)) for x in (880,900,930,959,961,970)])
