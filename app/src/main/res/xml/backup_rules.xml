<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for Android 11 and lower. android:allowBackup="false" already turns
   backup off there; the credential stores are excluded as well in case that changes.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="connection.xml" />
    <exclude domain="sharedpref" path="budget_encryption.xml" />
    <exclude domain="sharedpref" path="trusted_server_certificates.xml" />
</full-backup-content>
