<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 12+ backup and device-to-device transfer rules. android:allowBackup="false"
   turns off cloud backup, but not device-to-device transfer, so credential stores are
   excluded from both explicitly. Their Keystore keys never leave the device, so a copied
   value would be unreadable anyway.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="connection.xml" />
        <exclude domain="sharedpref" path="budget_encryption.xml" />
        <exclude domain="sharedpref" path="trusted_server_certificates.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="connection.xml" />
        <exclude domain="sharedpref" path="budget_encryption.xml" />
        <exclude domain="sharedpref" path="trusted_server_certificates.xml" />
    </device-transfer>
</data-extraction-rules>
