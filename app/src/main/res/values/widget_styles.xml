<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- One type scale for every widget: title 16/14sp (full/compact), body 14sp, labels 11sp. -->
    <style name="WidgetTitle">
        <item name="android:layout_width">0dp</item><item name="android:layout_height">wrap_content</item><item name="android:layout_weight">1</item>
        <item name="android:ellipsize">end</item><item name="android:maxLines">1</item>
        <item name="android:textColor">@color/widget_on_background</item><item name="android:textSize">16sp</item><item name="android:textStyle">bold</item>
    </style>
    <style name="WidgetTitle.Compact">
        <item name="android:textSize">14sp</item>
    </style>
    <style name="WidgetSubtitle">
        <item name="android:layout_width">wrap_content</item><item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:textColor">@color/widget_secondary_text</item><item name="android:textSize">11sp</item>
    </style>
    <style name="WidgetHeroValue">
        <item name="android:layout_width">wrap_content</item><item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/widget_primary</item><item name="android:textSize">30sp</item><item name="android:textStyle">bold</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <!-- A tonal tile holding a label over a value; the same surface as the buttons and amount pills. -->
    <style name="WidgetTile">
        <item name="android:layout_width">0dp</item><item name="android:layout_height">wrap_content</item><item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item><item name="android:background">@drawable/widget_button_background</item>
        <item name="android:paddingHorizontal">10dp</item><item name="android:paddingVertical">8dp</item>
    </style>
    <style name="WidgetLabel">
        <item name="android:layout_width">wrap_content</item><item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/widget_secondary_text</item><item name="android:textSize">11sp</item>
    </style>
    <style name="WidgetValue">
        <item name="android:layout_width">wrap_content</item><item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/widget_primary</item><item name="android:textSize">15sp</item><item name="android:textStyle">bold</item>
    </style>
    <style name="WidgetAction">
        <item name="android:layout_width">0dp</item><item name="android:layout_height">48dp</item><item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/widget_button_background</item><item name="android:gravity">center</item>
        <item name="android:textColor">@color/widget_primary</item><item name="android:textSize">13sp</item><item name="android:textStyle">bold</item>
    </style>
    <style name="WidgetRow">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">0dp</item><item name="android:layout_weight">1</item>
        <item name="android:gravity">center_vertical</item><item name="android:orientation">horizontal</item><item name="android:paddingTop">4dp</item><item name="android:paddingBottom">4dp</item>
    </style>
    <style name="WidgetRowName">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
        <item name="android:ellipsize">end</item><item name="android:maxLines">1</item><item name="android:textColor">@color/widget_on_background</item><item name="android:textSize">14sp</item>
    </style>
    <style name="WidgetRowAmount">
        <item name="android:layout_width">wrap_content</item><item name="android:layout_height">wrap_content</item><item name="android:layout_marginStart">12dp</item>
        <item name="android:background">@drawable/widget_button_background</item>
        <item name="android:paddingHorizontal">10dp</item><item name="android:paddingVertical">3dp</item>
        <item name="android:textColor">@color/widget_primary</item><item name="android:textSize">14sp</item><item name="android:textStyle">bold</item>
    </style>
    <style name="WidgetRowProgress" parent="@android:style/Widget.ProgressBar.Horizontal">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">@dimen/widget_row_progress_height</item><item name="android:layout_marginTop">6dp</item>
        <item name="android:progressDrawable">@drawable/widget_progress</item>
        <item name="android:progressTint">@color/widget_primary</item><item name="android:progressBackgroundTint">@color/widget_button</item>
    </style>
</resources>
