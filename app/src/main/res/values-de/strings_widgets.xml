    <string name="disconnect_reset_title">Trennen &amp; zurücksetzen?</string>
    <string name="disconnect_reset_message">Actua synchronisiert jedes heruntergeladene Serverbudget und entfernt dann heruntergeladene Serverbudgets, lokale Sicherungen, Verschlüsselungsschlüssel und Verbindungsdaten von diesem Gerät. Deine Budgets auf dem Actual-Server werden nicht gelöscht. Anzeigeeinstellungen des Geräts und das lokale Demo-Budget bleiben erhalten.</string>
    <string name="disconnect_reset_action">Trennen &amp; zurücksetzen</string>
    <string name="widget_action_cancel">Abbrechen</string>
    <string name="disconnect_syncing_title">Synchronisierung vor dem Trennen</string>
    <string name="disconnect_syncing_message">Die neuesten Actual- und Actua-Änderungen jedes heruntergeladenen Serverbudgets werden gespeichert, bevor lokale Daten entfernt werden.</string>
    <string name="disconnect_sync_failed_title">Letzte Änderungen konnten nicht synchronisiert werden</string>
    <string name="disconnect_sync_failed_message">Actua hat keine lokalen Budgetdaten entfernt. Wenn du trotzdem trennst, können Änderungen, die deinen Actual-Server nicht erreicht haben, dauerhaft verloren gehen.</string>
    <string name="disconnect_anyway">Trotzdem trennen</string>
    <string name="disconnect_try_again">Erneut versuchen</string>
    <string name="disconnect_error_sync_failed">Synchronisierung fehlgeschlagen.</string>
    <string name="disconnect_error_session_expired">Deine Serversitzung ist abgelaufen, daher können Änderungen nicht synchronisiert werden. Brich ab und melde dich unter „Verbindung &amp; Daten“ erneut an oder trenne trotzdem.</string>
    <string name="disconnect_error_missing_server_identity">%1$s hat keine Serveridentität und kann nach der Synchronisierung nicht sicher entfernt werden.</string>
    <string name="disconnect_error_not_configured">%1$s ist nicht für die Serversynchronisierung konfiguriert.</string>
