    <string name="disconnect_sync_failed_title">No se pudieron sincronizar los últimos cambios</string>
    <string name="disconnect_sync_failed_message">Actua no eliminó ningún dato de los presupuestos locales. Si te desconectas de todos modos, podrías perder permanentemente los cambios que todavía no hayan llegado a tu servidor de Actual.</string>
