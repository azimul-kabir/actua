    <string name="disconnect_sync_failed_title">Não foi possível sincronizar as alterações mais recentes</string>
    <string name="disconnect_sync_failed_message">O Actua não removeu nenhum dado local de orçamento. Desconectar mesmo assim pode descartar permanentemente alterações que ainda não chegaram ao seu servidor Actual.</string>
