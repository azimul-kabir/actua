<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_item_row"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="36dp" android:gravity="center_vertical" android:orientation="vertical"
    android:paddingTop="4dp" android:paddingBottom="4dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/widget_item_name" style="@style/WidgetRowName" android:layout_width="0dp" android:layout_weight="1" />
        <TextView android:id="@+id/widget_item_amount" style="@style/WidgetRowAmount" />
    </LinearLayout>
    <ProgressBar android:id="@+id/widget_item_progress" style="@style/WidgetRowProgress" />
</LinearLayout>
