<?xml version="1.0" encoding="utf-8"?>
<!-- Static picker preview with synthetic sample data. The real widget is bound with budget data. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">
    <!-- Not a useless parent: widget_background is an inset drawable, so the frame takes the inset as
         padding and this layout adds its own padding inside it. Merging them would drop one. -->
    <LinearLayout
        tools:ignore="UselessParent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/widget_padding_compact"
        android:paddingVertical="8dp">
        <TextView style="@style/WidgetLabel" android:layout_width="match_parent" android:maxLines="1" android:ellipsize="end" android:text="@string/widget_sample_report_card" />
        <TextView style="@style/WidgetValue" android:autoSizeMaxTextSize="22sp" android:text="@string/widget_sample_amount_8" />
    </LinearLayout>
</FrameLayout>
