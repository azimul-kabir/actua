<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/widget_padding_compact">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/widget_title"
                style="@style/WidgetTitle.Compact"
                android:text="@string/widget_budget_snapshot" />
            <TextView
                android:id="@+id/widget_month"
                style="@style/WidgetSubtitle"
                android:visibility="gone" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">
            <TextView
                android:id="@+id/widget_ready_label"
                style="@style/WidgetLabel"
                android:maxLines="1" android:ellipsize="end"
                android:text="@string/widget_ready" />
            <TextView
                android:id="@+id/widget_ready_value"
                style="@style/WidgetValue"
                android:textSize="22sp" android:autoSizeMaxTextSize="22sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
