<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="@string/widget_upcoming_schedules"
        android:textColor="@color/widget_on_background"
        android:textSize="16sp"
        android:textStyle="bold" />
    <TextView android:id="@+id/widget_empty" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:gravity="center" android:text="@string/widget_no_schedules"
        android:textColor="@color/widget_secondary_text" android:visibility="gone" />
    <ListView android:id="@+id/widget_schedule_list" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:divider="@null" android:dividerHeight="0dp" android:scrollbars="none" />
</LinearLayout>
